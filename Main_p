LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY Main_p IS
    PORT (
        A, B : IN  STD_LOGIC_VECTOR(3 DOWNTO 0);
        SW   : IN  STD_LOGIC_VECTOR(1 DOWNTO 0);
        Seg0 : OUT STD_LOGIC_VECTOR(6 DOWNTO 0);
        Seg1 : OUT STD_LOGIC_VECTOR(6 DOWNTO 0);
        Seg2 : OUT STD_LOGIC_VECTOR(6 DOWNTO 0);
        Seg3 : OUT STD_LOGIC_VECTOR(6 DOWNTO 0)
    );
END ENTITY;

ARCHITECTURE structural OF Main_p IS
    SIGNAL A_S       : STD_LOGIC_VECTOR(4 DOWNTO 0);
    SIGNAL B_S       : STD_LOGIC_VECTOR(4 DOWNTO 0);
    SIGNAL C_mul     : STD_LOGIC_VECTOR(6 DOWNTO 0);
    SIGNAL B_comp    : STD_LOGIC_VECTOR(4 DOWNTO 0);
    SIGNAL B_comp2   : STD_LOGIC_VECTOR(4 DOWNTO 0);
    SIGNAL B_aos     : STD_LOGIC_VECTOR(4 DOWNTO 0);
    SIGNAL Addr      : STD_LOGIC_VECTOR(4 DOWNTO 0);
    SIGNAL Addc      : STD_LOGIC;
    SIGNAL COM_A     : STD_LOGIC_VECTOR(2 DOWNTO 0);
    SIGNAL COO       : STD_LOGIC_VECTOR(6 DOWNTO 0);
    SIGNAL C_fin     : STD_LOGIC_VECTOR(6 DOWNTO 0);
    SIGNAL Div_dos   : STD_LOGIC_VECTOR(3 DOWNTO 0);
    SIGNAL Div_U     : STD_LOGIC_VECTOR(3 DOWNTO 0);
    SIGNAL C_sign    : STD_LOGIC_VECTOR(3 DOWNTO 0);
    SIGNAL Div_d     : STD_LOGIC_VECTOR(3 DOWNTO 0);

    SIGNAL IS_SUB    : STD_LOGIC;
    SIGNAL IS_MUL    : STD_LOGIC;
    SIGNAL NEG_RES   : STD_LOGIC;

    SIGNAL Sig_Seg_1 : STD_LOGIC_VECTOR(3 DOWNTO 0);
    SIGNAL Sig_Seg_2 : STD_LOGIC_VECTOR(3 DOWNTO 0);
    SIGNAL Sig_Seg_3 : STD_LOGIC_VECTOR(3 DOWNTO 0);
    SIGNAL Sig_Seg_4 : STD_LOGIC_VECTOR(3 DOWNTO 0);

BEGIN
    A_S <= '0' & A;
    B_S <= '0' & B;

    IS_SUB  <= '1' WHEN SW = "01" ELSE '0';
    IS_MUL  <= '1' WHEN SW = "10" ELSE '0';
    NEG_RES <= '1' WHEN (IS_SUB = '1' AND Addc = '0') ELSE '0';

    -- Si la resta es negativa, convertir a magnitud positiva
    COM_A <= "010" WHEN NEG_RES = '1' ELSE
             "000";

    -- Código especial para mostrar el signo menos
    C_sign <= "1010" WHEN NEG_RES = '1' ELSE
              "0000";

    COO <= "00" & B_comp2;

    Mul: ENTITY WORK.multiplicador
    PORT MAP(
        A => A,
        B => B,
        P => C_mul
    );

    A2: ENTITY WORK.Complemento_A2
    GENERIC MAP(bits => 5)
    PORT MAP(
        B      => B_S,
        SEL    => "010",
        SALIDA => B_comp
    );

    M2_1: ENTITY WORK.mux2_1
    PORT MAP(
        A  => B_S,
        B  => B_comp,
        SW => IS_SUB,
        Y  => B_aos
    );

    Sum: ENTITY WORK.full_adder
    GENERIC MAP(n_bits => 5)
    PORT MAP(
        A_SUM => A_S,
        B_SUM => B_aos,
        C_SUM => '0',
        S_SUM => Addr,
        C_OUT => Addc
    );

    A2_2: ENTITY WORK.Complemento_A2
    GENERIC MAP(bits => 5)
    PORT MAP(
        B      => Addr,
        SEL    => COM_A,
        SALIDA => B_comp2
    );

    Mux_op: ENTITY WORK.operacion_demux_when_else
    PORT MAP(
        Add => COO,
        Mul => C_mul,
        S   => IS_MUL,
        Res => C_fin
    );

    Sep_dig: ENTITY WORK.digit_separator
    PORT MAP(
        N        => C_fin,
        DECENAS  => Div_dos,
        UNIDADES => Div_U
    );

    -- Si es negativo, mostrar "-"; si no, mostrar decena
    Div_d <= C_sign WHEN NEG_RES = '1' ELSE Div_dos;

    -- Enviar directo a los displays
    Sig_Seg_1 <= A;
    Sig_Seg_2 <= B;
    Sig_Seg_3 <= Div_d;
    Sig_Seg_4 <= Div_U;

    Sseg: ENTITY WORK.Result_to_Sseg
    PORT MAP(
        A    => Sig_Seg_1,
        B    => Sig_Seg_2,
        V_S  => Sig_Seg_3,
        V_R  => Sig_Seg_4,
        Seg0 => Seg0,
        Seg1 => Seg1,
        Seg2 => Seg2,
        Seg3 => Seg3
    );

END ARCHITECTURE;
